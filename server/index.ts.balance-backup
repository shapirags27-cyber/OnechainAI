async function generateAIResponse(
  context: Array<{ role: string; content: string }>,
  systemInstruction: string
) {
  if (AI_PROVIDER !== 'gemini') {
    throw new Error(
      `Unsupported AI provider: ${AI_PROVIDER}`
    )
  }

  const contents = context.map(item => ({
    role: item.role === 'assistant' ? 'model' : 'user',
    parts: [
      {
        text: item.content
      }
    ]
  }))

  let lastError: unknown = null

  for (let attempt = 0; attempt < 3; attempt += 1) {
    try {
      const response = await client.models.generateContent({
        model: AI_PROVIDER_MODEL,
        contents,
        config: {
          systemInstruction
        }
      })

      return {
        id: response.responseId || crypto.randomUUID(),
        content: response.text || '',
        provider: AI_PROVIDER,
        providerModel: AI_PROVIDER_MODEL
      }
    } catch (error) {
      lastError = error

      if (attempt === 2) {
        break
      }

      await new Promise(resolve =>
        setTimeout(resolve, 500 * 2 ** attempt)
      )
    }
  }

  throw lastError instanceof Error
    ? lastError
    : new Error('AI provider request failed')
}

async function generateExecutionPlan(
  message: string,
  availableIntegrations: Array<{
    name: string
    handle: string
    description: string
  }>
): Promise<ExecutionPlan> {
  const integrationContext = availableIntegrations
    .map(
      integration =>
        `${integration.handle}: ${integration.name} — ${integration.description}`
    )
    .join('\n')

  const systemInstruction = `
You are the planning layer for Phorva OnechainAI.

Your job is to interpret the user's request and return ONLY a JSON execution plan.

You do NOT execute anything.
You do NOT claim an action was executed.
You do NOT invent integrations, tools, providers, addresses, balances, prices, or transaction results.

Available integrations:
${integrationContext || 'None'}

Return exactly this JSON shape:

{
  "intent": "short description of the user's intended action",
  "operation": "generic operation name or null",
  "provider": "integration handle or null",
  "providerMode": "explicit" | "discovery" | "none",
  "tool": "tool name or null",
  "arguments": {}
}

Rules:
- If the user explicitly names an integration/provider, preserve that choice.
- If the user requests an action but does not specify a provider, use providerMode "discovery".
- If no external action is being requested, use providerMode "none".
- Never invent a tool name. Use null when the tool is not known yet.
- Never decide authorization or verification requirements.
- operation must be a generic capability such as "get_balance", "swap", "send_transaction", or null.
- Never invent a tool name. Use null when the tool is not known yet.
- If the request cannot yet be mapped to a generic operation, keep operation as null.
- If the user explicitly names a provider, preserve it.
- If the user does not name a provider, use providerMode "discovery" and provider null.
- Return valid JSON only.
`

  let response: Awaited<
    ReturnType<typeof client.models.generateContent>
  > | null = null

  let lastError: unknown = null

  for (let attempt = 0; attempt < 3; attempt += 1) {
    try {
      response = await client.models.generateContent({
        model: AI_PROVIDER_MODEL,
        contents: [
          {
            role: 'user',
            parts: [
              {
                text: message
              }
            ]
          }
        ],
        config: {
          systemInstruction
        }
      })

      break
    } catch (error) {
      lastError = error

      if (attempt === 2) {
        break
      }

      await new Promise(resolve =>
        setTimeout(resolve, 500 * 2 ** attempt)
      )
    }
  }

  if (!response) {
    throw lastError instanceof Error
      ? lastError
      : new Error('Execution planner request failed')
  }

  const raw = response.text?.trim() || ''

  if (!raw) {
    throw new Error('Execution planner returned an empty response')
  }

  let parsed: unknown

  try {
    parsed = JSON.parse(raw)
  } catch {
    throw new Error('Execution planner returned invalid JSON')
  }

  if (
    typeof parsed !== 'object' ||
    parsed === null ||
    Array.isArray(parsed)
  ) {
    throw new Error('Execution planner returned an invalid plan')
  }

  const plan = parsed as Record<string, unknown>

  const providerMode =
    plan.providerMode === 'explicit' ||
    plan.providerMode === 'discovery' ||
    plan.providerMode === 'none'
      ? plan.providerMode
      : 'none'

  return {
    intent:
      typeof plan.intent === 'string'
        ? plan.intent
        : message,
    operation:
      typeof plan.operation === 'string'
        ? plan.operation
        : null,
    provider:
      typeof plan.provider === 'string'
        ? plan.provider
        : null,
    providerMode,
    tool:
      typeof plan.tool === 'string'
        ? plan.tool
        : null,
    arguments:
      typeof plan.arguments === 'object' &&
      plan.arguments !== null &&
      !Array.isArray(plan.arguments)
        ? plan.arguments as Record<string, unknown>
        : {},
    requiresAuthorization: false,
    requiresVerification: false
  }
}

const DATA_DIR = path.join(process.cwd(), 'server', 'data')
const MEMORY_FILE = path.join(DATA_DIR, 'memory.json')

fs.mkdirSync(DATA_DIR, { recursive: true })

function loadMemoryStore(): Record<string, any> {
  try {
    if (!fs.existsSync(MEMORY_FILE)) {
      fs.writeFileSync(MEMORY_FILE, '{}')
    }

    return JSON.parse(fs.readFileSync(MEMORY_FILE, 'utf8') || '{}')
  } catch {
    return {}
  }
}

function saveMemoryStore(store: Record<string, any>) {
  fs.writeFileSync(
    MEMORY_FILE,
    JSON.stringify(store, null, 2)
  )
}

function sendJson(
  res: http.ServerResponse,
  status: number,
  data: unknown
) {
  res.writeHead(status, {
    'Content-Type': 'application/json',
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Headers': 'Content-Type',
    'Access-Control-Allow-Methods': 'GET, POST, DELETE, OPTIONS'
  })

  res.end(JSON.stringify(data))
}

function readBody(req: http.IncomingMessage): Promise<any> {
  return new Promise((resolve, reject) => {
    let body = ''

    req.on('data', chunk => {
      body += chunk
    })

    req.on('end', () => {
      try {
        resolve(JSON.parse(body || '{}'))
      } catch (error) {
        reject(error)
      }
    })

    req.on('error', reject)
  })
}

function getUserId(payload: any) {
  if (
    typeof payload.userId === 'string' &&
    payload.userId.trim()
  ) {
    return payload.userId.trim()
  }

  return 'local-user'
}

